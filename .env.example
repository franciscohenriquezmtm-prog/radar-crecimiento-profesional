# ─────────────────────────────────────────────────────────────
#  Copia este archivo como  .env  y rellena lo que uses.
#  Nada de esto es obligatorio para que el panel funcione:
#  sin correo configurado el radar igual escanea y guarda todo.
# ─────────────────────────────────────────────────────────────

# ── CORREO DIARIO ────────────────────────────────────────────
# Con Gmail: verificacion en 2 pasos + "Contrasena de aplicacion"
# en https://myaccount.google.com/apppasswords (16 caracteres, sin espacios).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=franciscohenriquezmtm@gmail.com
SMTP_PASS=
CORREO_DESTINO=franciscohenriquezmtm@gmail.com

# ── PUSH AL TELEFONO con ntfy (opcional) ─────────────────────
# Instala la app ntfy, suscribete a un topic secreto y ponlo aqui.
# Puede ser un topic distinto al de tus otros radares.
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh

# ── TELEGRAM (opcional) ──────────────────────────────────────
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# ── AVANZADO ─────────────────────────────────────────────────
# Puerto del panel local. Tus otros radares usan 4785, 4786 y 5173.
# PUERTO_PANEL=4787
#
# Milisegundos de espera entre peticiones al mismo sitio.
# ESPERA_MS=900
#
# LOG_NIVEL=info
